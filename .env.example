# Скопируй в .env и заполни. Файл не коммитим.

# Токен от @BotFather
BOT_TOKEN=

# Пароль администратора камер Dahua.
# Используется и Frigate (RTSP), и guard (проверка камеры при /addcam).
FRIGATE_RTSP_PASSWORD=

# Пароль пользователя Frigate. Нужен, только если ходить на порт 8971
# вместо внутреннего 5000 — по умолчанию оставь пустым.
FRIGATE_PASSWORD=

# Внешний сторож. Оставь пустым и выключи heartbeat в guard/config.yaml,
# если сторож ещё не развёрнут.
WATCHDOG_URL=https://watchdog.example.com/heartbeat
WATCHDOG_TOKEN=

# Куда Frigate пишет записи. Отдельный диск указывать здесь.
FRIGATE_MEDIA=./frigate/media

TZ=Europe/Moscow
LOG_LEVEL=INFO
