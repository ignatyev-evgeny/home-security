# Тот же бот, что и дома: сторож только отправляет сообщения и за getUpdates
# с локальным сервисом не конкурирует.
BOT_TOKEN=
CHAT_IDS=000000000

# Общий секрет с домашним сервером. Сгенерировать: openssl rand -hex 32
AUTH_TOKEN=

STALE_SECONDS=180
CHECK_INTERVAL=30
WATCHDOG_PORT=8080

# Домен для docker-compose.override.yml на сервере с Traefik.
WATCHDOG_DOMAIN=watchdog.example.com
LOG_LEVEL=INFO
