[Unit]
Description=Проверять, не зависло ли видеоядро

[Timer]
# Первая проверка через минуту после загрузки, дальше — раз в минуту.
# Сам скрипт ничего не делает, пока аптайм меньше 15 минут: если графика
# виснет прямо на старте, машина не должна уйти в цикл перезагрузок.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
