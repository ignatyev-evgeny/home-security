[Unit]
Description=Следить за сроком ручного режима вентилятора

[Timer]
# Заявку исполняет .path — мгновенно. Таймер нужен для другого: снять ручной
# режим, когда истёк срок или процессор перегрелся. Без него предохранители
# сработали бы только при следующей команде, то есть могли не сработать вовсе.
OnBootSec=2min
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
